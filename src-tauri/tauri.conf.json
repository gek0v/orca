{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orca",
  "version": "1.4.214",
  "identifier": "ai.stably.orca",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Orca",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Orca — AI-native high-performance developer workspace",
    "longDescription": "High-performance developer workspace and terminal multiplexer powered by Rust and Tauri v2.",
    "copyright": "Copyright (c) 2026 Stably AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["en-US", "es-ES"]
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1", "librsvg2-2"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
